AWSTemplateFormatVersion: '2010-09-09'
Description: 'Infraestrutura Base Nativa .NET 7.0 (Via Script Oficial) para Esteira de CI/CD'

Resources:
  VpcMinimalAPI:
    Type: 'AWS::EC2::VPC'
    Properties:
      CidrBlock: '10.0.0.0/16'
      EnableDnsSupport: true
      EnableDnsHostnames: true
      Tags:
        - Key: Name
          Value: 'VPC-Portfolio-CICD'

  SubnetPublicaAPI:
    Type: 'AWS::EC2::Subnet'
    Properties:
      VpcId: !Ref VpcMinimalAPI
      CidrBlock: '10.0.1.0/24'
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: 'Subnet-Publica-CICD'

  InternetGateway:
    Type: 'AWS::EC2::InternetGateway'
    Properties:
      Tags:
        - Key: Name
          Value: 'IGW-CICD'

  VpcGatewayAttachment:
    Type: 'AWS::EC2::VPCGatewayAttachment'
    Properties:
      VpcId: !Ref VpcMinimalAPI
      InternetGatewayId: !Ref InternetGateway

  RouteTablePublica:
    Type: 'AWS::EC2::RouteTable'
    Properties:
      VpcId: !Ref VpcMinimalAPI
      Tags:
        - Key: Name
          Value: 'RT-CICD'

  RotaParaInternet:
    Type: 'AWS::EC2::Route'
    Properties:
      RouteTableId: !Ref RouteTablePublica
      DestinationCidrBlock: '0.0.0.0/0'
      GatewayId: !Ref InternetGateway

  SubnetAssociation:
    Type: 'AWS::EC2::SubnetRouteTableAssociation'
    Properties:
      SubnetId: !Ref SubnetPublicaAPI
      RouteTableId: !Ref RouteTablePublica

  SecurityGroupMinimalAPI:
    Type: 'AWS::EC2::SecurityGroup'
    Properties:
      GroupDescription: 'Libera portas para a API (5092) e acesso do GitHub Actions (22)'
      VpcId: !Ref VpcMinimalAPI
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 5092
          ToPort: 5092
          CidrIp: '0.0.0.0/0'
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: '0.0.0.0/0'
      Tags:
        - Key: Name
          Value: 'SG-CICD-Randstad'

  InstanciaServidorAPI:
    Type: 'AWS::EC2::Instance'
    Properties:
      InstanceType: 't3.micro'
      ImageId: 'ami-0eab37cfdc33e8e65' # Ubuntu 24.04 LTS em Ohio
      SubnetId: !Ref SubnetPublicaAPI
      SecurityGroupIds:
        - !Ref SecurityGroupMinimalAPI
      KeyName: 'testando-ci-cd'
      Tags:
        - Key: Name
          Value: 'Servidor-Producao-API'
      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash
          apt-get update -y
          apt-get install -y wget apt-transport-https zip unzip

          # AUTOMAÇÃO CRÍTICA: Baixa e executa o script oficial da Microsoft para instalar o runtime do .NET 7
          wget https://dot.net/v1/dotnet-install.sh -O /tmp/dotnet-install.sh
          chmod +x /tmp/dotnet-install.sh
          
          # Instala o runtime no diretório global /usr/share/dotnet
          /tmp/dotnet-install.sh --runtime dotnet --version 7.0.20 --install-dir /usr/share/dotnet

          # Cria um link simbólico global para que o comando 'dotnet' responda em qualquer sessão SSH
          ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet

          # Prepara o diretório de deploy com as permissões corretas
          mkdir -p /var/www/minimal-api
          chown -R ubuntu:ubuntu /var/www/minimal-api

Outputs:
  UrlAPI:
    Description: 'URL pública para acessar o Swagger da API'
    Value: !Sub 'http://${InstanciaServidorAPI.PublicIp}:5092/swagger/index.html'
  IpPublicoEC2:
    Description: 'IP Público da Instância para mapear no GitHub Secrets'
    Value: !GetAtt InstanciaServidorAPI.PublicIp